{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for the main Canglang window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/Celec7/Canglang*" },
        { "url": "https://github.com/xqbase/eleeye*" },
        { "url": "https://github.com/noobpwnftw/chessdb*" },
        { "url": "https://github.com/official-pikafish/Pikafish*" },
        { "url": "https://github.com/tauri-apps/tauri*" },
        { "url": "https://github.com/rust-lang/rust*" },
        { "url": "https://github.com/vuejs/core*" }
      ]
    }
  ]
}
